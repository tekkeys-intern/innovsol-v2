# Copy to .env (local) or set in your host's dashboard (Vercel → Settings → Environment Variables).
# NEVER commit real values.

# ── Contact form email (server-side only; used by /api/contact) ─────────────
SMTP_HOST=smtp.example.com
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@innovsol.ai
SMTP_FROM_NAME=Innovsol Website
SMTP_TO=hello@innovsol.ai

# ── Public site URL (used by the sitemap / canonical tags generators) ───────
SITE_URL=https://innovsol.ai

# ── Version 2 portal (Supabase). Both are PUBLIC values, safe in the browser
#    because row-level security protects the data. Leave blank to keep the portal off.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The service-role key must NEVER be a VITE_ variable and never reach the browser.

# ── Contact form hardening / integrations (all optional) ────────────────────
SMTP_PORT=587
AUTO_REPLY=1                         # 0 = do not email an acknowledgement to the sender
CRM_WEBHOOK_URL=                     # forward every enquiry as JSON (HubSpot / Zoho / Zapier / Make)
CRM_WEBHOOK_TOKEN=
TURNSTILE_SECRET_KEY=                # Cloudflare Turnstile (server). Public site key goes in content/site.json
UPSTASH_REDIS_REST_URL=              # shared rate limiting across serverless instances
UPSTASH_REDIS_REST_TOKEN=

# ── Operations ──────────────────────────────────────────────────────────────
ADMIN_TOKEN=                         # enables /api/test-smtp (send header x-admin-token). Leave blank in prod to keep it off
NOTIFY_SECRET=                       # shared secret for the Supabase webhook → /api/notify
SUPABASE_URL=                        # server-side (same as VITE_SUPABASE_URL)
SUPABASE_SERVICE_ROLE_KEY=           # SERVER ONLY. Used by /api/notify. Never prefix with VITE_
